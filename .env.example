# Production Postgres connection string (Neon, Supabase, or Vercel-compatible Postgres)
DATABASE_URL=
# Required in production; used to hash short-lived rate-limit keys
RATE_LIMIT_SECRET=
# Optional public origin for metadata, e.g. https://untraced.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# local (default) uses .data/untraced.sqlite; postgres uses DATABASE_URL
UNTRACED_DATABASE=local
# normal | empty | early | late | one-remaining | completed
UNTRACED_FIXTURE=normal
# Set only for an intentional production seed/reset
ALLOW_PRODUCTION_SEED=false
